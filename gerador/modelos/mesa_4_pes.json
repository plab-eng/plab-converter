          0,
          150
        ],
        "origem": "regra"
      }
    ],
    "componentes": [
      {
        "id": "tampo",
        "padrao": "caixa",
        "args": {
          "largura": "Largura",
          "profundidade": "Profundidade",
          "altura": "Espessura_Tampo",
          "base": "Altura - Espessura_Tampo"
        },
        "subcategoria": "Tampo"
      },
      {
        "id": "pe",
        "padrao": "array_retangular",
        "subcategoria": "Pes",
        "args": {
          "linhas": 2,
          "colunas": 2,
          "item": {
            "padrao": "caixa",
            "args": {
              "largura": "Lado_Pe",
              "profundidade": "Lado_Pe",
              "altura": "Altura - Espessura_Tampo",
              "centro_x": "(2 * i - 3) * (Largura / 2 - Recuo_Pe - Lado_Pe / 2)",
              "centro_y": "(2 * j - 3) * (Profundidade / 2 - Recuo_Pe - Lado_Pe / 2)"
            }
          }
        }
      }
    ]
  },
