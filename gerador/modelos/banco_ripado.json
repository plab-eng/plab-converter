              "centro_y": "0 - Profundidade / 2 + Lado_Tubo / 2"
            }
          }
        }
      },
      {
        "id": "montante",
        "padrao": "array_retangular",
        "subcategoria": "Estrutura",
        "args": {
          "linhas": 2,
          "colunas": 1,
          "item": {
            "padrao": "caixa",
            "args": {
              "largura": "Lado_Tubo",
              "profundidade": "Lado_Tubo",
              "altura": "Altura_Total",
              "centro_x": "(2 * i - 3) * (Comprimento / 2 - Lado_Tubo / 2)",
              "centro_y": "Profundidade / 2 - Lado_Tubo / 2"
            }
          }
        }
      },
      {
        "id": "travessa_lateral",
        "padrao": "array_retangular",
        "subcategoria": "Estrutura",
        "args": {
          "linhas": 2,
          "colunas": 1,
          "item": {
            "padrao": "caixa",
            "args": {
              "largura": "Lado_Tubo",
              "profundidade": "Profundidade - 2 * Lado_Tubo",
              "altura": "Lado_Tubo",
              "base": "Altura_Assento - Espessura_Ripa - Lado_Tubo",
              "centro_x": "(2 * i - 3) * (Comprimento / 2 - Lado_Tubo / 2)"
            }
          }
        }
      },
      {
        "id": "travessa_frontal",
        "padrao": "caixa",
        "subcategoria": "Estrutura",
        "args": {
          "largura": "Comprimento - 2 * Lado_Tubo",
          "profundidade": "Lado_Tubo",
          "altura": "Lado_Tubo",
          "base": "Altura_Assento - Espessura_Ripa - Lado_Tubo",
          "centro_y": "0 - Profundidade / 2 + Lado_Tubo / 2"
        }
      },
      {
        "id": "ripa_assento",
        "padrao": "array_linear",
        "subcategoria": "Ripas",
        "args": {
          "n": "3",
          "item": {
            "padrao": "caixa",
            "args": {
              "largura": "Comprimento - 2 * Lado_Tubo",
              "profundidade": "(Profundidade - 24) / 3",
              "altura": "Espessura_Ripa",
              "base": "Altura_Assento - Espessura_Ripa",
              "centro_y": "0 - Profundidade / 2 + (k - 1) * ((Profundidade - 24) / 3 + 12) + ((Profundidade - 24) / 3) / 2"
            }
          }
        }
      },
      {
        "id": "ripa_encosto",
        "padrao": "array_linear",
        "subcategoria": "Ripas",
        "args": {
          "n": "2",
          "item": {
            "padrao": "caixa",
            "args": {
              "largura": "Comprimento - 2 * Lado_Tubo",
              "profundidade": "Espessura_Ripa",
              "altura": "(Altura_Total - Altura_Assento - Folga_Encosto - 30) / 2",
              "base": "Altura_Assento + Folga_Encosto + (k - 1) * ((Altura_Total - Altura_Assento - Folga_Encosto - 30) / 2 + 30)",
              "centro_y": "Profundidade / 2 - Lado_Tubo / 2"
            }
          }
        }
      }
    ]
