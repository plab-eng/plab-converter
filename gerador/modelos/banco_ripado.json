        "args": {
          "linhas": 2,
          "colunas": 1,
          "item": {
            "padrao": "caixa",
            "args": {
              "largura": "Lado_Tubo",
              "profundidade": "Lado_Tubo",
              "altura": "Altura_Assento - Espessura_Ripa",
